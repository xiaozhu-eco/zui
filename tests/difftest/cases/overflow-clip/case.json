{
  "name": "overflow-clip",
  "page": "page.html",
  "viewport": [800, 600],
  "_comment": "Phase1: overflow:clip clips overflowing children and is not a scroll container.",
  "matrix": ["flow.overflow"],
  "required": true,
  "steps": [
    { "op": "load" },
    { "op": "resize", "w": 800, "h": 600 },
    { "op": "trace" },
    { "op": "capture" }

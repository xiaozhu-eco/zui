{
  "name": "container-query",
  "page": "page.html",
  "viewport": [800, 600],
  "_comment": "容器查询：宽度变化后帧末重入必须按新的 cqw 重排后代（LAYOUT 第 10 节）。",
  "matrix": ["container.query"],
  "required": true,
  "steps": [
    { "op": "load" },
    { "op": "resize", "w": 800, "h": 600 },

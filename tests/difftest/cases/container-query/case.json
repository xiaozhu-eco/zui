    { "op": "eval", "actions": [{ "do": "set_style", "target": "#cont", "props": { "width": "400px" } }] },
    { "op": "trace" },
    { "op": "capture" }
  ],
  "expect": "golden/",
  "pixels": "strict",
  "text": { "breaks": false, "advances": false }
}

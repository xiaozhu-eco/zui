{
  "name": "marker-image-reversed",
  "page": "page.html",
  "viewport": [800, 600],
  "_comment": "ol reversed 倒序计数（无 start 时首项为项数，start 为第一项序号）。list-style-image 用 url() 替换项目符号。",
  "matrix": ["css.marker"],
  "required": true,
  "steps": [
    { "op": "load" },
    { "op": "resize", "w": 800, "h": 600 },
    { "op": "trace" },
    { "op": "capture" }
  ],
  "expect": "golden/",
  "pixels": "strict",
  "pixel_tolerance": 1,
  "text": { "breaks": true, "advances": true }
}

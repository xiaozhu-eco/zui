{
  "name": "paint-clip-polygon",
  "page": "page.html",
  "viewport": [800, 600],
  "_comment": "clip-path: polygon() nonzero / evenodd，px 与 %。无文字。必过像素对拍。",
  "matrix": ["paint.clip-path"],
  "required": true,
  "steps": [
    { "op": "load" },
    { "op": "resize", "w": 800, "h": 600 },
    { "op": "trace" },
    { "op": "capture" }
  ],
  "expect": "golden/",
  "pixels": "strict",
  "pixel_tolerance": 1,
  "text": { "breaks": false, "advances": false }
}

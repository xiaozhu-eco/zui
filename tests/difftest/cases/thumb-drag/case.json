{
  "name": "thumb-drag",
  "page": "page.html",
  "viewport": [
    800,
    600
  ],
  "_comment": "Press, move, and release on the vertical thumb.",
  "matrix": [
    "scroll.overflow"
  ],
  "required": true,
  "steps": [
    {
      "op": "load"
    },
    {

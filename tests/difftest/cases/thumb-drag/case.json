      "op": "dispatch",
      "events": [
        {
          "type": "mousePressed",
          "x": 310,
          "y": 40,
          "button": "left",
          "count": 1
        },
        {
          "type": "mouseMoved",
          "x": 310,
          "y": 120
        },
        {
          "type": "mouseReleased",
          "x": 310,
          "y": 120,
          "button": "left",
          "count": 1
        }
      ]
    },
    {
      "op": "trace"
    }
  ],
  "expect": "golden/",
  "pixels": "strict",
  "text": {
    "breaks": false,
    "advances": false
  }
}

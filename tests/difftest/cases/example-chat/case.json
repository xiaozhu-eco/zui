  "scripts": false,
  "_comment": "小竹聊天去掉页面脚本后的静态壳。会话条目与两种气泡、顶部「新建」的 hover/按下、消息流滚轮、Tab/Escape，最后撤掉 #creator 的 hidden。",
  "matrix": [],
  "required": true,
  "steps": [
    {
      "op": "load"
    },
    {
      "op": "resize",
      "w": 1100,
      "h": 720

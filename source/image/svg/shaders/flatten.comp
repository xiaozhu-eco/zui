#version 450
layout(local_size_x = 64) in;

#ifdef ZUI_PUSH
layout(push_constant) uniform ParamsBlock {
#else
layout(std140, binding = 0) uniform ParamsBlock {
#endif
    ivec4 viewport;
    vec4 rect;
    vec4 extra;
} zui_params;

struct Curve {
    vec4 a;
    vec4 b;
    int kind;
    int shape;
    int pad0;
    int pad1;
};

struct Seg {
    vec4 ab;
    int shape;
    int pad0;
    int pad1;
    int pad2;
};

layout(std430, binding = 1) readonly buffer CurveBlock { Curve curves[]; };
layout(std430, binding = 2) buffer SegBlock { Seg segs[]; };

vec2 zui_quad(vec2 p0, vec2 p1, vec2 p2, float t) {
    float u = 1.0 - t;
    return u * u * p0 + 2.0 * u * t * p1 + t * t * p2;
}

vec2 zui_cubic(vec2 p0, vec2 p1, vec2 p2, vec2 p3, float t) {
    float u = 1.0 - t;
    return u * u * u * p0 + 3.0 * u * u * t * p1 + 3.0 * u * t * t * p2 + t * t * t * p3;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(zui_params.viewport.w)) {
        return;
    }
    Curve curve = curves[id];
    vec2 p0 = curve.a.xy;
    vec2 p1 = curve.a.zw;
    vec2 p2 = curve.b.xy;
    vec2 p3 = curve.b.zw;
    for (int i = 0; i < 16; ++i) {
        vec2 a = p0;
        vec2 b = p0;
        if (curve.kind == 1) {
            if (i == 0) {
                b = p1;
            }
        } else {
            float t0 = float(i) / 16.0;
            float t1 = float(i + 1) / 16.0;
            if (curve.kind == 2) {
                a = zui_quad(p0, p1, p2, t0);
                b = zui_quad(p0, p1, p2, t1);
            } else {
                a = zui_cubic(p0, p1, p2, p3, t0);
                b = zui_cubic(p0, p1, p2, p3, t1);
            }
        }
        uint slot = id * 16u + uint(i);
        segs[slot].ab = vec4(a, b);
        segs[slot].shape = curve.shape;
    }
}
